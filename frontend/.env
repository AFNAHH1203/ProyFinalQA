# ==================== CONFIGURACIÓN DE ENTORNO ====================
# Copia este archivo como .env.local y ajusta los valores según tu entorno

# ==================== API CONFIGURATION ====================
# URL base de tu API backend
VITE_API_BASE_URL=http://localhost:3000/qa

# Timeout para requests de API (en milisegundos)
VITE_API_TIMEOUT=30000

# ==================== APP CONFIGURATION ====================
# Información básica de la aplicación
VITE_APP_NAME=QA App
VITE_APP_VERSION=1.0.0
VITE_APP_DESCRIPTION=Carrito de Compras con AI
VITE_APP_URL=http://localhost:5173

# ==================== STORAGE CONFIGURATION ====================
# Prefijo para keys en localStorage
VITE_STORAGE_PREFIX=QA-app

# ==================== SECURITY CONFIGURATION ====================
# Habilitar HTTPS (true/false)
VITE_HTTPS_ENABLED=false

# Dominios permitidos para CORS (separados por comas)
VITE_ALLOWED_ORIGINS=http://localhost:3000/qa,http://localhost:5173

# Clave para encriptación local (no sensible)
VITE_LOCAL_ENCRYPTION_KEY=my_local_encryption_key_2024

# ==================== FEATURES CONFIGURATION ====================
# Habilitar modo debug (true/false)
VITE_DEBUG_ENABLED=true

# Habilitar analytics (true/false)
VITE_ANALYTICS_ENABLED=false

# ID de Google Analytics (opcional)
VITE_ANALYTICS_ID=

# Habilitar carrito de compras (true/false)
VITE_CART_ENABLED=true

# Habilitar sistema de pagos (true/false)
VITE_PAYMENTS_ENABLED=false

# Modo mantenimiento (true/false)
VITE_MAINTENANCE_MODE=false

# ==================== THIRD PARTY SERVICES ====================
# Configuración de EmailJS (para envío de emails)
VITE_EMAIL_SERVICE_ID=
VITE_EMAIL_TEMPLATE_ID=
VITE_EMAIL_PUBLIC_KEY=

# Google Maps API Key
VITE_GOOGLE_MAPS_API_KEY=

# Coordenadas por defecto (Guatemala City)
VITE_DEFAULT_LAT=14.6349
VITE_DEFAULT_LNG=-90.5069

# URLs de redes sociales
VITE_FACEBOOK_URL=https://facebook.com/tu-pagina
VITE_TWITTER_URL=https://twitter.com/tu-cuenta
VITE_INSTAGRAM_URL=https://instagram.com/tu-cuenta
VITE_LINKEDIN_URL=https://linkedin.com/company/tu-empresa
VITE_YOUTUBE_URL=https://youtube.com/tu-canal

# ==================== LOCALIZATION ====================
# Idioma por defecto
VITE_DEFAULT_LANGUAGE=es

# Idiomas soportados (separados por comas)
VITE_SUPPORTED_LANGUAGES=es,en

# Configuración regional
VITE_DEFAULT_CURRENCY=GTQ
VITE_DEFAULT_TIMEZONE=America/Guatemala
VITE_DATE_FORMAT=DD/MM/YYYY
VITE_TIME_FORMAT=HH:mm

# ==================== DESARROLLO ====================
# Puerto del servidor de desarrollo
PORT=5173

# Host del servidor de desarrollo
HOST=localhost